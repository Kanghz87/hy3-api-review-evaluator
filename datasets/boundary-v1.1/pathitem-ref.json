{
  "openapi": "3.1.0",
  "info": {
    "title": "pathitem-ref",
    "version": "1.0.0",
    "description": "Self-constructed boundary test; no production data."
  },
  "servers": [
    {
      "url": "https://boundary.example.test"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/items": {
      "$ref": "#/components/pathItems/Shared"
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "pathItems": {
      "Shared": {
        "get": {
          "summary": "Read items",
          "responses": {
            "200": {
              "description": "Success"
            },
            "400": {
              "description": "Invalid input"
            }
          }
        }
      }
    }
  }
}
