{
  "openapi": "3.1.0",
  "info": {
    "title": "parameter-ref-chain",
    "version": "1.0.0",
    "description": "Self-constructed boundary test; no production data."
  },
  "servers": [
    {
      "url": "https://boundary.example.test"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/items/{id}": {
      "get": {
        "operationId": "listItems",
        "summary": "Read items",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Alias"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": false,
        "schema": {
          "type": "string"
        }
      },
      "Alias": {
        "$ref": "#/components/parameters/Id"
      }
    }
  }
}
