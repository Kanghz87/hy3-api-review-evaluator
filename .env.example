# Copy this file to .env and fill the key locally. Never commit .env.
HY3_API_KEY=
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1
HY3_MODEL=hy3
HY3_TIMEOUT_SECONDS=90
HY3_MAX_RETRIES=0
HY3_REASONING_EFFORT=high

# Input and model-output bounds.
HY3_MAX_FILE_BYTES=2000000
HY3_MAX_CONTAINER_NODES=200000
HY3_MAX_NESTING_DEPTH=100
HY3_MAX_MODEL_CHARS=120000
HY3_MAX_OUTPUT_TOKENS=16000

# Real-call budget. The experiment runner refuses calls that can exceed this cap.
HY3_TOTAL_TOKEN_BUDGET=850000
HY3_DEFAULT_RUN_TOKEN_BUDGET=150000
